# Copy to .env next to docker-compose.yml and fill in.

# The public hostname Caddy serves and requests a certificate for, WITHOUT the
# scheme, e.g. app.jannawebsite.online. It must already resolve to this server's
# public IP before `docker compose up`, or Let's Encrypt issuance fails.
SITE_DOMAIN=

# Address Let's Encrypt uses for expiry warnings. Optional but recommended.
ACME_EMAIL=

# The public https origin, e.g. https://app.jannawebsite.online
# Used for absolute share/setup links. Normally https:// + SITE_DOMAIN.
PUBLIC_ORIGIN=

# Her local timezone (used for dates in push notifications).
TZ=Europe/Moscow

# --- Admin panel "Deploy from GitHub" (optional) ---
# Absolute path to this repo's clone ON THE HOST (e.g. /opt/janna-website).
# Leave blank to skip this feature entirely — everything else works without it.
HOST_REPO_PATH=

# Shared secret between the app and the updater sidecar. Generate with:
#   openssl rand -hex 24
UPDATER_TOKEN=

# Branch the server tracks and redeploys from.
DEPLOY_BRANCH=main
