# Copy to .env next to docker-compose.yml and fill in.

# Token from Cloudflare Zero Trust → Networks → Tunnels → your tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# The public https origin the tunnel serves, e.g. https://babushka.example.com
# Used for absolute share/setup links.
PUBLIC_ORIGIN=

# Her local timezone (used for dates in push notifications).
TZ=Europe/Moscow

# --- Admin panel "Deploy from GitHub" (optional) ---
# Absolute path to this repo's clone ON THE HOST (e.g. /home/pi/janna-website).
# Leave blank to skip this feature entirely — everything else works without it.
HOST_REPO_PATH=

# Shared secret between the app and the updater sidecar. Generate with:
#   openssl rand -hex 24
UPDATER_TOKEN=

# Branch the Pi tracks and redeploys from.
DEPLOY_BRANCH=main
