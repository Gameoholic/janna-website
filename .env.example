# Copy to .env next to docker-compose.yml and fill in.

# Token from Cloudflare Zero Trust → Networks → Tunnels → your tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# The public https origin the tunnel serves, e.g. https://babushka.example.com
# Used for absolute share/setup links.
PUBLIC_ORIGIN=

# Her local timezone (used for dates in push notifications).
TZ=Europe/Moscow
